# ==============================================================================
# KONFIGURASI LINGKUNGAN (ENVIRONMENT VARIABLES) TASKHUB - HARI 3
# ==============================================================================
# Slide 30: "export WEBHOOK_SECRET=... node --watch src/server.js"
# Slide 44: "Secret manager, bukan env var & repo"
# Salin berkas ini ke .env untuk konfigurasi lokal Anda: cp .env.example .env

# Port server TaskHub API (default 3000 sesuai Slide 29)
PORT=3000

# Path database SQLite TaskHub (Slide 17, 24, 32)
DATABASE_URL=./taskhub.db

# Kunci rahasia bersama (Shared Secret) untuk verifikasi tanda tangan HMAC-SHA256 Webhook (Slide 9, 11, 21, 30)
# Minimal 32 karakter hexadecimal acak
WEBHOOK_SECRET=4f8b2d1c9e7a6f5e3d2c1b0a9f8e7d6c5b4a39281706f5e4d3c2b1a0f9e8d7c6

# Origin yang diizinkan untuk Browser CORS (Slide 46)
ALLOWED_ORIGIN=https://app.taskhub.example.com

# Lingkungan aplikasi ('development', 'test', 'production')
NODE_ENV=development
